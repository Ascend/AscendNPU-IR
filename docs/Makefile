# Minimal makefile for Sphinx documentation
# Default target: clean _build then build English (fresh output every time).

SPHINXOPTS    ?=
SPHINXBUILD   ?= sphinx-build
SOURCEDIR     = .
BUILDDIR      = _build

# Project root (parent of docs/) and paths to the bishengir pass/dialect md generator + deps.
ROOT            ?= $(CURDIR)/..
GEN_SCRIPT      ?= $(CURDIR)/scripts/gen_bishengir_pass_dialect_md.sh
LLVM_TD         ?= $(ROOT)/third-party/llvm-project/mlir/include
# Standalone builder for the 2 doc tools (mlir-tblgen + yaml-gen) when the main
# build is absent. ccache-accelerated; one-time (~1.5min).
TD2MD_TOOLS_SCRIPT ?= $(CURDIR)/scripts/build_td2md_tools.sh
TD2MD_TOOLS_BUILD  ?= $(ROOT)/build/td2md-tools
DOCS_DIALECTS ?= $(SOURCEDIR)/source/en/developer_guide/dialects
DOCS_PASSES   ?= $(SOURCEDIR)/source/en/developer_guide/passes
# Generated doc basenames (snake_case, matching the gen script TABLE).
# Pass/transform-op entries are file:Title — the Title becomes the H1 heading
# (those .md lack an H1; sphinx :titlesonly: needs one).
DIALECT_DOCS  := annotation_dialect hacc_dialect hfusion_dialect hivm_dialect \
                 math_ext_dialect memref_ext_dialect scope_dialect symbol_dialect
PASS_DOCS     := annotation_passes:Annotation hacc_passes:HACC \
                 hfusion_passes:HFusion hivm_passes:HIVM \
                 scope_passes:Scope symbol_passes:Symbol \
                 bishengir_llvm_passes:BiShengIRLLVM \
                 execution_engine_passes:ExecutionEngine
TRANSFORM_OPS := bishengir_scf_loop_transform_ops:BiShengIRSCFLoopTransformOps \
                 hfusion_transform_ops:HFusionTransformOps \
                 hivm_transform_ops:HIVMTransformOps

# Keep `all` the default goal even though gen-bishengir-pass-dialect-md is
# defined first (make otherwise picks the first target as default).
.DEFAULT_GOAL := all

# Fetch the llvm-project submodule (shallow) if not present. It provides both
# the mlir .td includes (gen-md needs) and the llvm CMake source (build-td2md-tools
# configures from). Shared prerequisite so it's fetched exactly once.
fetch-llvm-project:
	@if [ ! -d "$(LLVM_TD)" ]; then \
		echo "Fetching llvm-project submodule (depth 1)..."; \
		cd "$(ROOT)" && git submodule update --init --depth 1 third-party/llvm-project; \
	fi

# Build mlir-tblgen + bishengir-hfusion-ods-yaml-gen into $(TD2MD_TOOLS_BUILD) —
# used when the main build doesn't provide them. ccache-accelerated; one-time (~1.5min).
build-td2md-tools: fetch-llvm-project
	@if [ -x "$(ROOT)/build/bin/mlir-tblgen" ]; then \
		echo "[td2md-tools] main build already provides mlir-tblgen; nothing to do."; \
	elif [ -x "$(TD2MD_TOOLS_BUILD)/bin/mlir-tblgen" ]; then \
		echo "[td2md-tools] already built at $(TD2MD_TOOLS_BUILD)."; \
	else \
		echo "[td2md-tools] building the 2 doc tools (one-time, ~1.5min) ..."; \
		"$(TD2MD_TOOLS_SCRIPT)"; \
	fi

# Generate the bishengir pass/dialect .md docs (from .td via mlir-tblgen), copy
# them into the source tree, and regenerate the dialects/passes index.rst
# toctrees so every copied .md is auto-referenced. Depends on build-td2md-tools
# (which fetches llvm-project + builds the 2 tools if the main build lacks them).
gen-bishengir-pass-dialect-md: build-td2md-tools
	@if [ -x "$(ROOT)/build/bin/mlir-tblgen" ]; then BD="$(ROOT)/build"; \
	elif [ -x "$(TD2MD_TOOLS_BUILD)/bin/mlir-tblgen" ]; then BD="$(TD2MD_TOOLS_BUILD)"; \
	else echo "ERROR: mlir-tblgen not found (run: make build-td2md-tools)"; exit 1; fi; \
	OUT="$$BD/bishengir-pass-dialect-md"; \
	echo "[bishengir-md] generating docs from $$BD ..."; \
	BUILD_DIR="$$BD" OUT_DIR="$$OUT" "$(GEN_SCRIPT)"; \
	for d in $(DIALECT_DOCS); do sed '/\[TOC\]/d' "$$OUT/$$d.md" > "$(DOCS_DIALECTS)/$$d.md"; done; \
	for p in $(PASS_DOCS); do f=$${p%%:*}; t=$${p##*:}; { printf '# %s\n\n' "$$t"; cat "$$OUT/$$f.md"; } > "$(DOCS_PASSES)/$$f.md"; done; \
	for t in $(TRANSFORM_OPS); do f=$${t%%:*}; ttl=$${t##*:}; { printf '# %s\n\n' "$$ttl"; cat "$$OUT/$$f.md"; } > "$(DOCS_PASSES)/$$f.md"; done; \
	{ printf '.. Auto-generated by make gen-bishengir-pass-dialect-md - do not edit by hand.\n'; \
	  printf '   To add/remove a doc, edit DIALECT_DOCS/PASS_DOCS/TRANSFORM_OPS in docs/Makefile, then re-run make.\n\n'; \
	  printf 'Dialects\n========\n\n.. toctree::\n   :titlesonly:\n\n'; \
	  ls "$(DOCS_DIALECTS)"/*.md 2>/dev/null | sed 's#.*/##; s/\.md$$//' | sort | sed 's/^/   /'; } > "$(DOCS_DIALECTS)/index.rst"; \
	{ printf '.. Auto-generated by make gen-bishengir-pass-dialect-md - do not edit by hand.\n'; \
	  printf '   To add/remove a doc, edit DIALECT_DOCS/PASS_DOCS/TRANSFORM_OPS in docs/Makefile, then re-run make.\n\n'; \
	  printf 'Passes\n======\n\n.. toctree::\n   :titlesonly:\n\n'; \
	  ls "$(DOCS_PASSES)"/*.md 2>/dev/null | sed 's#.*/##; s/\.md$$//' | sort | sed 's/^/   /'; } > "$(DOCS_PASSES)/index.rst"; \
	echo "Copied dialect+transform-op+pass docs and regenerated index.rst files (from $$BD)."

# Default: clean and build English (ensures fresh static output on every make -C docs)
all: clean html
	@echo "Done. English HTML in $(BUILDDIR)/html"

# Remove generated static files under _build/
clean:
	@rm -rf "$(BUILDDIR)"
	@echo "Cleaned $(BUILDDIR)/"

help:
	@$(SPHINXBUILD) -M help "$(SOURCEDIR)" "$(BUILDDIR)" $(SPHINXOPTS) $(O)

# Build English docs (conf.py reads READTHEDOCS_LANGUAGE for exclude_patterns)
html: gen-bishengir-pass-dialect-md
	@LANGUAGE=en $(SPHINXBUILD) -b html -c $(SOURCEDIR) -D language=en "$(SOURCEDIR)/source/en" "$(BUILDDIR)/en" $(SPHINXOPTS) $(O)
	@echo "English HTML built in $(BUILDDIR)/en"
	@printf '%s\n' '<!DOCTYPE html>' \
		'<html>' \
		'<head>' \
		'  <meta charset="utf-8"/>' \
		'  <meta http-equiv="refresh" content="0; url=en/index.html"/>' \
		'  <title>AscendNPU IR Docs</title>' \
		'</head>' \
		'<body>' \
		'  <p>Redirecting to <a href="en/index.html">English documentation</a>...</p>' \
		'</body>' \
		'</html>' > "$(BUILDDIR)/index.html"
	@echo "Root $(BUILDDIR)/index.html created (default → English)"

# Build Chinese docs (conf.py writes index.html redirect via build-finished for RTD + local)
html-zh: gen-bishengir-pass-dialect-md
	@LANGUAGE=zh_CN $(SPHINXBUILD) -b html -c $(SOURCEDIR) -D language=zh_CN "$(SOURCEDIR)/source/zh_cn" "$(BUILDDIR)/zh_cn" $(SPHINXOPTS) $(O)
	@echo "Chinese HTML built in $(BUILDDIR)/zh_cn"

# Build both: English in _build/en, Chinese in _build/zh_cn (for local preview)
html-all: clean html html-zh
	@echo "Both languages built. Serve e.g. _build/en and _build/zh_cn."

.PHONY: all clean help Makefile fetch-llvm-project build-td2md-tools gen-bishengir-pass-dialect-md html html-zh html-all

%: Makefile
	@$(SPHINXBUILD) -M $@ "$(SOURCEDIR)" "$(BUILDDIR)" $(SPHINXOPTS) $(O)
