// RUN: bishengir-opt %s -normalize-vector -convert-vector-to-hivmave -canonicalize -cse -mlir-print-elementsattrs-with-hex-if-larger=-1 | FileCheck %s

// Split a sparse logical mask between the two sub-gathers.
// The logical mask enables result elements 0, 3, 198 and 255.
// The even-index gather must enable lanes 0 and 99.
// The odd-index gather must enable lanes 1 and 127.
// This distinguishes parity splitting from taking the low/high mask halves,
// and checks the last odd lane.
// CHECK-LABEL: func.func @dual_gather_sparse_mask
// CHECK-DAG: %[[ME:.*]] = arith.constant dense<[true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false]> : vector<128xi1>
// CHECK-DAG: %[[MO:.*]] = arith.constant dense<[false, true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, true]> : vector<128xi1>
// CHECK: ave.hir.vgather %{{.*}}[%{{.*}}] [%{{.*}}], %[[ME]] : memref<256xi8, {{.*}}>, vector<128xi16>, vector<128xi1> into vector<128xi16>
// CHECK: ave.hir.vgather %{{.*}}[%{{.*}}] [%{{.*}}], %[[MO]] : memref<256xi8, {{.*}}>, vector<128xi16>, vector<128xi1> into vector<128xi16>
module attributes {hacc.target = #hacc.target<"Ascend950PR_9579">} {
  func.func @dual_gather_sparse_mask(%src: memref<256xi8, #hivm.address_space<ub>>) -> vector<256xi8> attributes {hivm.func_core_type = #hivm.func_core_type<AIV>, hivm.vector_function} {
    %c0 = arith.constant 0 : index
    %pass = arith.constant dense<0> : vector<256xi8>
    %even = arith.constant dense<0> : vector<128xi16>
    %mask = arith.constant dense<[true, false, false, true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, true]> : vector<256xi1>
    %res = vector.gather %src[%c0] [%even], %mask, %pass {secondary_index = dense<1> : vector<128xi16>} : memref<256xi8, #hivm.address_space<ub>>, vector<128xi16>, vector<256xi1>, vector<256xi8> into vector<256xi8>
    return %res : vector<256xi8>
  }
}
